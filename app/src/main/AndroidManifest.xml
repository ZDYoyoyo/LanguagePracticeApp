<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 下載題庫（以及之後的 Drive 同步、廣告）需要網路 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 發通知需要使用者同意（每日提醒用，App 內開啟提醒時才會詢問） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 開機後重新排每日提醒（系統鬧鐘在重開機後會清空） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Credential Manager 函式庫會帶入生物辨識權限（給密碼金鑰用），本 App 用不到 → 移除 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!--
      AdMob 函式庫會自動合併以下權限（不需手動宣告）：
      - ACCESS_NETWORK_STATE：判斷網路狀態以載入廣告
      - com.google.android.gms.permission.AD_ID：讀取廣告 ID（個人化廣告 / 成效統計）
      若 App 主要對象是兒童（Designed for Families），必須移除 AD_ID，把下面這行取消註解：
      <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    -->

    <!--
      allowBackup=false：關閉 Android 系統自動備份。
      這樣「移除 App 即清除資料」才成立；跨裝置保留資料改由使用者自選的 Google Drive 同步。
    -->
    <!-- Android 11+ 套件可見性：宣告要用到的系統服務（朗讀、語音辨識、寄信），不是權限 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".EnglishApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnglishPractice">

        <!-- AdMob App ID：由 build.gradle.kts 依建置類型注入（debug 一律為測試 ID） -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- 分享成績卡圖片給其他 App（不需要儲存權限） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 桌面小工具 -->
        <receiver
            android:name=".widget.DailyWidgetProvider"
            android:exported="false"
            android:label="英語練習：今日單字">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_widget_info" />
        </receiver>

        <!-- 每日提醒：鬧鐘響起、開機、改時間、App 更新後重新排程 -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：不參與雲端備份與裝置間轉移（資料只存本機，或由使用者自選的 Google Drive 同步） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
